                wishOrder: "9",
                totalScore: "177.5",
                certificate: "الثانوية العامة - ثانوية عامة علمي رياضة",
                announcementDate: "2026-11-21",
                year: "عام 2026 م"
            }
        };

        // عناصر واجهة المستخدم
        const loginView = document.getElementById('login-view');
        const resultView = document.getElementById('result-view');
        const searchForm = document.getElementById('search-form');
        const seatInput = document.getElementById('seat-number-input');
        const errorBox = document.getElementById('error-box');
        const errorMessage = document.getElementById('error-message');

        /**
         * تحويل الأرقام العربية الشرقية (٠١٢٣...) إلى أرقام إنجليزية (0123...) لتسهيل الإدخال من أي لوحة مفاتيح
         */
        function normalizeDigits(str) {
            return str.replace(/[٠-٩]/g, d => '0123456789'['٠١٢٣٤٥٦٧٨٩'.indexOf(d)]).trim();
        }

        /**
         * دالة لتوليد مصفوفة QR Code واقعية وفريدة بناءً على بيانات الطالب (رقم الجلوس واسم الطالب)
         * ترسم مربعات التحديد الثلاثة القياسية (Finder Patterns) ونمط البيانات المشفر
         */
        function renderStudentQRCode(seedText) {
            const canvas = document.getElementById('qr-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const size = canvas.width;
            const modules = 25; // شبكة 25x25 وحدة قياسية
            const cellSize = size / modules;

            // خلفية بيضاء نقية
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, size, size);

            // دالة مساعدة لرسم مربع تحديد QR (7x7 وحدات)
            function drawFinderPattern(startX, startY) {
                ctx.fillStyle = '#000000';
                ctx.fillRect(startX * cellSize, startY * cellSize, 7 * cellSize, 7 * cellSize);
                ctx.fillStyle = '#ffffff';
                ctx.fillRect((startX + 1) * cellSize, (startY + 1) * cellSize, 5 * cellSize, 5 * cellSize);
                ctx.fillStyle = '#000000';
                ctx.fillRect((startX + 2) * cellSize, (startY + 2) * cellSize, 3 * cellSize, 3 * cellSize);
            }

            // رسم مربعات التحديد الثلاثة (أعلى اليمين، أعلى اليسار، أسفل اليسار)
            drawFinderPattern(0, 0);
            drawFinderPattern(modules - 7, 0);
            drawFinderPattern(0, modules - 7);

            // توليد بذرة رقمية ثابتة من نص الطالب لضمان ثبات الكود لنفس الطالب واختلافه بين الطالبين
            let hash = 2166136261;
            for (let i = 0; i < seedText.length; i++) {
                hash ^= seedText.charCodeAt(i);
                hash = Math.imul(hash, 16777619);
            }

            // مولد عشوائي حتمي (PRNG)
            function nextRandom() {
                hash += 0x6D2B79F5;
                let t = Math.imul(hash ^ (hash >>> 15), 1 | hash);
                t ^= t + Math.imul(t ^ (t >>> 7), 61 | t);
                return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
            }

            // ملء باقي الخلايا بنمط QR واقعي مع ترك مسافة أمان حول مربعات التحديد
            ctx.fillStyle = '#000000';
            for (let row = 0; row < modules; row++) {
                for (let col = 0; col < modules; col++) {
                    // تجنب مناطق مربعات التحديد الثلاثة + المسافة الفاصلة (8x8)
                    const inTopLeft = (row < 8 && col < 8);
                    const inTopRight = (row < 8 && col >= modules - 8);
                    const inBottomLeft = (row >= modules - 8 && col < 8);

                    if (inTopLeft || inTopRight || inBottomLeft) continue;

                    // إضافة خطوط التوقيت القياسية في الصف 6 والعمود 6
                    if (row === 6 || col === 6) {
                        if ((row + col) % 2 === 0) {
                            ctx.fillRect(col * cellSize, row * cellSize, cellSize, cellSize);
                        }
                        continue;
                    }

                    // رسم وحدات البيانات
                    if (nextRandom() > 0.48) {
                        ctx.fillRect(col * cellSize, row * cellSize, cellSize, cellSize);
                    }
                }
            }
        }

        /**
         * عرض بطاقة الترشيح للطالب المحدد
         */
        function displayStudentCard(student) {
            try {
                // تعبئة البيانات في الحقول
                document.getElementById('res-year').textContent = student.year;
                document.getElementById('res-student-name').textContent = student.name;
                document.getElementById('res-college').textContent = student.college;
                document.getElementById('res-wish-order').textContent = student.wishOrder;
                document.getElementById('res-seat-number').textContent = student.seatNumber;
                document.getElementById('res-total-score').textContent = student.totalScore;
                document.getElementById('res-certificate').textContent = student.certificate;
                document.getElementById('res-announcement-date').textContent = student.announcementDate;

                // توليد كود QR الخاص بالطالب
                renderStudentQRCode(`${student.seatNumber}-${student.name}-${student.totalScore}`);

                // التبديل بين الشاشات
                errorBox.classList.add('hidden');
                loginView.classList.add('hidden');
                resultView.classList.remove('hidden');

                // الصعود لأعلى الصفحة بسلاسة
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } catch (err) {
                console.error("خطأ أثناء عرض النتيجة:", err);
            }
        }

        /**
         * البحث عن الطالب برقم الجلوس
         */
        function searchStudentBySeat(rawSeat) {
            const cleanSeat = normalizeDigits(rawSeat);

            if (!cleanSeat) {
                errorMessage.textContent = "يرجى إدخال رقم الجلوس أولاً.";
                errorBox.classList.remove('hidden');
                seatInput.focus();
                return;
            }

            const student = STUDENTS_DATABASE[cleanSeat];

            if (student) {
                displayStudentCard(student);
            } else {
                errorMessage.textContent = `عفواً، رقم الجلوس (${cleanSeat}) غير مسجل في قاعدة بيانات التنسيق. يرجى التأكد من الرقم والمحاولة مرة أخرى.`;
                errorBox.classList.remove('hidden');
                seatInput.focus();
            }
        }

        /**
         * الرجوع إلى شاشة الاستعلام
         */
        function goBackToSearch() {
            resultView.classList.add('hidden');
            loginView.classList.remove('hidden');
            errorBox.classList.add('hidden');
            seatInput.value = '';
            seatInput.focus();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // الاستماع لحدث إرسال النموذج
        searchForm.addEventListener('submit', function(e) {
            e.preventDefault();
            searchStudentBySeat(seatInput.value);
        });

        // إخفاء رسالة الخطأ بمجرد بدء المستخدم في تعديل الرقم
        seatInput.addEventListener('input', function() {
            if (!errorBox.classList.contains('hidden')) {
                errorBox.classList.add('hidden');
            }
        });
    </script>
</body>
</html>
